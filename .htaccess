# Show the site's own page for addresses that do not exist.
ErrorDocument 404 /404.php

# PHP on this server cannot open files in folders with a space in the name
# ("File not found."). run.php opens them instead, so "opdracht 1.2/" just works.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# a .php file somewhere under a folder with a space
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule " .*\.php$" run.php [L]

# such a folder itself, when its page is index.php
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule " .*/$" run.php [L]
</IfModule>
